# ── App ──────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=debug
PORT=3000

# 32+ 字符随机串（至少 32 字符）：用于加密 MCP 的 env / headers 中的密钥
# 生成：node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
APP_SECRET_KEY=

# ── Auth ─────────────────────────────────────────────────────────
# 单管理员登录；密码至少 12 字符，且不能是 admin-change-me / changeme / password
ADMIN_USER=admin
ADMIN_PASSWORD=

# 会话签名密钥，至少 32 字符；同样用上面的命令生成
JWT_SECRET=

# 浏览器 Origin allowlist，逗号分隔；生产改成实际访问地址，不要用 *
CORS_ORIGINS=http://localhost:5173
# 反向代理之后设为 1，信任 X-Forwarded-For / X-Forwarded-Proto
# TRUST_PROXY=1
# 仅测试/排障：1 = 关闭限流
# RATE_LIMIT_DISABLED=1

# ── PostgreSQL ───────────────────────────────────────────────────
DATABASE_URL=postgres://agentport:agentport@localhost:5432/agentport

# ── Redis / BullMQ ───────────────────────────────────────────────
# 用 compose 的 redis 时必须带密码（服务默认 --requirepass agentport-dev）；
# 连无密码的外部 Redis 时改回 redis://localhost:6379。
REDIS_URL=redis://:agentport-dev@localhost:6379

# ── Agent ────────────────────────────────────────────────────────
# 二选一：ANTHROPIC_API_KEY 或 ANTHROPIC_AUTH_TOKEN
ANTHROPIC_API_KEY=
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_BASE_URL=

# 模型、并发与超时
AGENT_DEFAULT_MODEL=claude-sonnet-5-5
AGENT_MAX_CONCURRENT=2
AGENT_TIMEOUT_MS=600000
# 已被 api schema 解析但当前代码不读取；预算由每个 agent 的 maxBudgetUsd 决定
AGENT_MAX_BUDGET_USD=2

# ── Retention ────────────────────────────────────────────────────
# 每日维护任务：终态运行保留天数、消息保留天数、每个智能体保留的版本数
RETAIN_RUN_DAYS=90
RETAIN_MESSAGE_DAYS=30
RETAIN_AGENT_VERSIONS=50

# ── Sandbox ──────────────────────────────────────────────────────
SANDBOX_IMAGE=agentport/sandbox:dev
# 工作区根目录。compose 部署时由 compose 覆盖为 /workspaces（命名卷挂载点），不用改这里。
WORKSPACES_DIR=./data/workspaces
# 仅 compose 部署需要：宿主视角的工作区路径，沙盒 bind mount 的源路径由宿主 daemon 解析。
# 默认是命名卷目录，rootless Docker 或自定义 data-root 时必须改成 `docker volume inspect agentport_workspaces` 的 Mountpoint。
# HOST_WORKSPACES_DIR=/var/lib/docker/volumes/agentport_workspaces/_data
# Linux 上 docker 组 GID 不是 0 时设置，worker 才能访问 docker.sock。
# DOCKER_GID=998

# 沙盒资源与出网：proxy（默认，需同时设置 HTTPS_PROXY）/ open（bridge，无代理）/ none（断网，模型与 MCP 全不可用）
# 默认 proxy 但未设代理时启动会 warn 并回退到 open，不阻塞本地开发。
SANDBOX_EGRESS=proxy
SANDBOX_MEMORY=1g
SANDBOX_CPUS=1
SANDBOX_PIDS=128
# 沙盒内访问平台 API 的地址；compose 部署保持默认（host.docker.internal）
# SANDBOX_API_URL=http://host.docker.internal:3000

# ── Platform MCP ─────────────────────────────────────────────────
# 启用 /mcp（把已启用智能体暴露为 MCP 工具）时必填，≥16 字符；留空则 /mcp 不存在。
PLATFORM_MCP_TOKEN=

# 平台自身可达地址（generated server 的 /mcp 端点自测用）
SELF_URL=http://127.0.0.1:3000

# Postgres 连接池上限（默认 10；高并发可调到 20-30，需先确认 max_connections）
DB_POOL_MAX=10

# ── 仅 compose 使用（api/worker 进程不读取） ─────────────────────
# Redis 密码，compose 的 redis 服务与 api/worker 连接串共用
# REDIS_PASSWORD=agentport-dev
