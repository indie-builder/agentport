{
  "name": "@agentport/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun ./node_modules/nodemon/bin/nodemon.js --signal SIGTERM --watch src --watch ../core/dist --watch ../db/dist --watch ../shared/dist --watch ../contract/dist --ext ts,tsx,mts,cts,js,mjs,cjs,json --exec 'bun --env-file=../../.env' src/index.ts",
    "build": "tsc -b",
    "start": "bun dist/index.js",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@agentport/contract": "workspace:*",
    "@agentport/core": "workspace:*",
    "@agentport/db": "workspace:*",
    "@agentport/shared": "workspace:*",
    "@modelcontextprotocol/client": "catalog:",
    "@modelcontextprotocol/server": "2.4.0",
    "@orpc/contract": "1.16.1",
    "@orpc/openapi": "1.16.1",
    "@orpc/server": "1.16.1",
    "@orpc/zod": "1.16.1",
    "@scalar/hono-api-reference": "0.12.18",
    "better-auth": "1.7.15",
    "bullmq": "catalog:",
    "csv-parse": "7.0.3",
    "drizzle-orm": "catalog:",
    "effect": "catalog:",
    "exceljs": "4.4.0",
    "fflate": "0.8.3",
    "hono": "4.13.16",
    "hono-rate-limiter": "0.5.4",
    "mdast-util-from-markdown": "2.1.0",
    "opencc-js": "1.4.2",
    "p-limit": "7.3.3",
    "pino": "catalog:",
    "pino-pretty": "13.2.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@modelcontextprotocol/node": "2.1.2",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "nodemon": "3.1.14"
  }
}
