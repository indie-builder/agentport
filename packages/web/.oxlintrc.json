{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [],
  "categories": {
    "correctness": "off"
  },
  "jsPlugins": ["@shadcn/lint"],
  "settings": {
    "shadcn": {
      "note": "See packages/web/DESIGN.md for design rules and packages/web/src/styles.css for theme tokens."
    }
  },
  "rules": {
    "shadcn/no-raw-colors": ["error", { "deny": ["*-white", "*-black"] }],
    "shadcn/no-unknown-classes": "error",
    "shadcn/no-arbitrary-values": [
      "error",
      {
        "allow": ["layout", "motion", "forced-colors:*"]
      }
    ],
    "shadcn/no-inline-styles": [
      "error",
      {
        "allow": [
          "width",
          "height",
          "minWidth",
          "maxHeight",
          "paddingLeft",
          "gap",
          "gridTemplateColumns",
          "maskImage",
          "WebkitMaskImage"
        ]
      }
    ],
    "shadcn/no-restyle": [
      "warn",
      {
        "allow": ["layout"],
        "contracts": [
          {
            "pattern": "^(?:Collapsible|CollapsibleTrigger|CollapsibleContent|TooltipTrigger|PopoverTrigger|DialogTrigger|DropdownMenuTrigger)$",
            "allow": ["*"]
          },
          {
            "pattern": "^(?:Field|FieldGroup|FieldSet|FieldContent|CardContent|CardHeader|CardFooter|CardAction|SheetContent|DialogContent|DialogHeader|Tabs|TabsList|TabsContent|ChartLegendContent)$",
            "allow": ["layout", "spacing"]
          },
          {
            "pattern": "^(?:CardTitle|CardDescription)$",
            "allow": ["layout", "typography", "spacing"]
          },
          {
            "pattern": "^(?:TableCell|TableHead)$",
            "allow": ["layout", "spacing", "typography", "color"]
          },
          {
            "pattern": "^(?:Input|Textarea)$",
            "allow": ["layout", "typography"]
          },
          {
            "pattern": "^SelectValue$",
            "allow": ["layout", "truncate"]
          },
          {
            "pattern": "^Skeleton$",
            "allow": ["layout", "shape"]
          },
          {
            "pattern": "^Card$",
            "allow": ["layout"],
            "message": "Card owns its surface depth and spacing. Use size (default, sm) and hover (static, shadow, lift) instead of restyling; see packages/web/DESIGN.md."
          },
          {
            "pattern": "^Button$",
            "allow": ["layout"],
            "message": {
              "spacing": "Use a Button size ({{sizes}}) instead of padding; use margin here or gap on the parent for outer spacing.",
              "default": "Use a Button variant ({{variants}}) defined in {{file}} instead of overriding appearance."
            }
          },
          {
            "pattern": "^Badge$",
            "allow": ["layout"],
            "message": "Use a Badge variant ({{variants}}) defined in {{file}} or StatusBadge instead of overriding appearance."
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": ["src/components/ui/**"],
      "rules": {
        "shadcn/no-restyle": "off",
        "shadcn/no-arbitrary-values": "off"
      }
    },
    {
      "files": ["src/components/ui/chart.tsx"],
      "rules": {
        "shadcn/no-inline-styles": "off"
      }
    },
    {
      "files": ["src/components/ui/toggle-group.tsx"],
      "rules": {
        "shadcn/no-inline-styles": "off"
      }
    },
    {
      "files": ["src/openui/components/charts.tsx"],
      "rules": {
        "shadcn/no-inline-styles": [
          "error",
          {
            "allow": [
              "width",
              "height",
              "minWidth",
              "maxHeight",
              "paddingLeft",
              "gap",
              "gridTemplateColumns",
              "maskImage",
              "WebkitMaskImage"
            ],
            "allowDynamicIdentifiers": ["tooltipStyle"]
          }
        ]
      }
    }
  ]
}
