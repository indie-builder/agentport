{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [],
  "categories": {
    "correctness": "off"
  },
  "jsPlugins": ["@shadcn/lint"],
  "settings": {
    "shadcn": {
      "note": "See packages/web/DESIGN.md for design rules and packages/web/src/styles.css for theme tokens."
    }
  },
  "rules": {
    "shadcn/no-raw-colors": ["error", { "deny": ["*-white", "*-black"] }],
    "shadcn/no-unknown-classes": "error",
    "shadcn/no-arbitrary-values": [
      "error",
      {
        "allow": [
          "layout",
          "motion",
          "forced-colors:*",
          "tracking-[-0.01em]",
          "tracking-[-0.02em]",
          "tracking-[0.06em]"
        ]
      }
    ],
    "shadcn/no-inline-styles": [
      "error",
      {
        "allow": [
          "width",
          "height",
          "minWidth",
          "maxHeight",
          "paddingLeft",
          "gap",
          "gridTemplateColumns",
          "maskImage",
          "WebkitMaskImage"
        ]
      }
    ],
    "shadcn/no-restyle": [
      "warn",
      {
        "allow": ["layout"],
        "contracts": [
          {
            "pattern": "^(?:Collapsible|CollapsibleTrigger|CollapsibleContent|TooltipTrigger|PopoverTrigger|DialogTrigger|DropdownMenuTrigger)$",
            "allow": ["*"]
          },
          {
            "pattern": "^(?:Field|FieldGroup|FieldSet|CardContent|CardHeader|CardFooter|SheetContent|DialogContent|Tabs|TabsContent|ChartLegendContent)$",
            "allow": ["layout", "spacing"]
          },
          {
            "pattern": "^(?:CardTitle|CardDescription)$",
            "allow": ["layout", "typography", "spacing"]
          },
          {
            "pattern": "^(?:TableCell|TableHead)$",
            "allow": ["layout", "spacing", "typography", "color"]
          },
          {
            "pattern": "^(?:Input|Textarea)$",
            "allow": ["layout", "typography"]
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": ["src/components/ui/**"],
      "rules": {
        "shadcn/no-restyle": "off",
        "shadcn/no-arbitrary-values": "off"
      }
    },
    {
      "files": ["src/components/ui/chart.tsx"],
      "rules": {
        "shadcn/no-inline-styles": "off"
      }
    },
    {
      "files": ["src/components/ui/toggle-group.tsx"],
      "rules": {
        "shadcn/no-inline-styles": "off"
      }
    },
    {
      "files": ["src/openui/components/charts.tsx"],
      "rules": {
        "shadcn/no-inline-styles": [
          "error",
          {
            "allow": [
              "width",
              "height",
              "minWidth",
              "maxHeight",
              "paddingLeft",
              "gap",
              "gridTemplateColumns",
              "maskImage",
              "WebkitMaskImage"
            ],
            "allowDynamicIdentifiers": ["tooltipStyle"]
          }
        ]
      }
    },
    {
      "files": ["src/pages/agents/agents-page.tsx"],
      "rules": {
        "shadcn/no-arbitrary-values": [
          "error",
          {
            "allow": [
              "layout",
              "motion",
              "forced-colors:*",
              "tracking-[-0.01em]",
              "tracking-[-0.02em]",
              "tracking-[0.06em]",
              "tracking-[0.16em]",
              "tracking-[0.22em]",
              "rounded-[18px]",
              "rounded-[24px]"
            ]
          }
        ]
      }
    },
    {
      "files": ["src/components/knowledge/knowledge-wiki-graph.tsx"],
      "rules": {
        "shadcn/no-arbitrary-values": [
          "error",
          {
            "allow": [
              "layout",
              "motion",
              "forced-colors:*",
              "tracking-[-0.01em]",
              "tracking-[-0.02em]",
              "tracking-[0.06em]",
              "text-[10px]"
            ]
          }
        ]
      }
    }
  ]
}
