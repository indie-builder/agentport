{
  "name": "@agentport/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./repo/servers.js": {
      "types": "./dist/repo/servers.d.ts",
      "default": "./dist/repo/servers.js"
    },
    "./repo/agents.js": {
      "types": "./dist/repo/agents.d.ts",
      "default": "./dist/repo/agents.js"
    },
    "./repo/chat.js": {
      "types": "./dist/repo/chat.d.ts",
      "default": "./dist/repo/chat.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch --preserveWatchOutput",
    "typecheck": "tsc -b",
    "generate": "drizzle-kit generate",
    "migrate": "node --env-file-if-exists=../../.env scripts/migrate.js",
    "typecheck:test": "tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@agentport/core": "workspace:*",
    "@agentport/shared": "workspace:*",
    "drizzle-orm": "0.45.4",
    "pg": "8.23.1",
    "typeid-js": "1.2.0"
  },
  "devDependencies": {
    "@types/pg": "8.15.6",
    "drizzle-kit": "0.31.11"
  }
}
