{
  "name": "@agentport/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch --preserveWatchOutput",
    "typecheck": "tsc -b",
    "generate": "drizzle-kit generate",
    "migrate": "bun --env-file=../../.env scripts/migrate.js"
  },
  "dependencies": {
    "@agentport/core": "workspace:*",
    "@agentport/shared": "workspace:*",
    "better-auth": "1.7.23",
    "drizzle-orm": "catalog:",
    "typeid-js": "1.2.0"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "drizzle-kit": "0.31.11"
  }
}
