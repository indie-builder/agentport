{
  "name": "@agentport/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false --env-file-if-exists=../../.env src/index.ts",
    "build": "tsc -b",
    "start": "node dist/index.js",
    "maintenance": "node --env-file-if-exists=../../.env --import tsx src/maintenance.ts",
    "typecheck": "tsc -b",
    "typecheck:test": "tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@agentport/core": "workspace:*",
    "@agentport/db": "workspace:*",
    "@agentport/shared": "workspace:*",
    "bullmq": "6.3.17",
    "drizzle-orm": "0.45.4",
    "effect": "4.0.5",
    "ioredis": "6.0.0",
    "pino": "10.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "tsx": "4.23.15"
  }
}
