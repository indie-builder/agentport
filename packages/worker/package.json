{
  "name": "@agentport/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun ./node_modules/nodemon/bin/nodemon.js --signal SIGTERM --watch src --watch ../core/dist --watch ../db/dist --watch ../shared/dist --ext ts,tsx,mts,cts,js,mjs,cjs,json --exec 'bun --env-file=../../.env' src/index.ts",
    "build": "tsc -b",
    "start": "bun dist/index.js",
    "maintenance": "bun --env-file=../../.env src/maintenance.ts",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@agentport/core": "workspace:*",
    "@agentport/db": "workspace:*",
    "@agentport/shared": "workspace:*",
    "@anthropic-ai/claude-agent-sdk": "0.3.316",
    "bullmq": "catalog:",
    "csv-parse": "7.0.3",
    "drizzle-orm": "catalog:",
    "effect": "catalog:",
    "fast-xml-parser": "5.12.0",
    "feedsmith": "3.0.1",
    "mdast-util-from-markdown": "2.1.0",
    "pino": "catalog:",
    "sharp": "0.35.5",
    "turndown": "7.2.5",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@types/turndown": "5.0.6",
    "nodemon": "3.1.14"
  }
}
