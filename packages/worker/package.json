{
  "name": "@agentport/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false --env-file-if-exists=../../.env src/index.ts",
    "build": "tsc -b",
    "start": "node dist/index.js",
    "maintenance": "node --env-file-if-exists=../../.env --import tsx src/maintenance.ts",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@agentport/core": "workspace:*",
    "@agentport/db": "workspace:*",
    "@agentport/shared": "workspace:*",
    "@anthropic-ai/claude-agent-sdk": "0.3.316",
    "bullmq": "catalog:",
    "csv-parse": "7.0.3",
    "drizzle-orm": "catalog:",
    "effect": "catalog:",
    "fast-xml-parser": "5.11.2",
    "feedsmith": "3.0.1",
    "ioredis": "catalog:",
    "mdast-util-from-markdown": "2.1.0",
    "pino": "catalog:",
    "sharp": "0.35.5",
    "turndown": "7.2.4",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/turndown": "5.0.6",
    "tsx": "catalog:"
  }
}
