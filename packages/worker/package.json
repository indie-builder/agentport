{
  "name": "@agentport/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false --env-file-if-exists=../../.env src/index.ts",
    "build": "tsc -b",
    "start": "node dist/index.js",
    "maintenance": "node --env-file-if-exists=../../.env --import tsx src/maintenance.ts",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@agentport/core": "workspace:*",
    "@agentport/db": "workspace:*",
    "@agentport/shared": "workspace:*",
    "bullmq": "catalog:",
    "drizzle-orm": "catalog:",
    "effect": "catalog:",
    "ioredis": "catalog:",
    "pino": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsx": "catalog:"
  }
}
