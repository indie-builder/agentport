{
  "name": "@agentport/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./workspace": {
      "types": "./dist/workspace.d.ts",
      "default": "./dist/workspace.js"
    },
    "./workspace-input": {
      "types": "./dist/workspace-input.d.ts",
      "default": "./dist/workspace-input.js"
    },
    "./plugin-display": {
      "types": "./dist/plugin-display.d.ts",
      "default": "./dist/plugin-display.js"
    },
    "./net-guard": {
      "types": "./dist/net-guard.d.ts",
      "default": "./dist/net-guard.js"
    },
    "./logger": {
      "types": "./dist/logger.d.ts",
      "default": "./dist/logger.js"
    },
    "./record": {
      "types": "./dist/record.d.ts",
      "default": "./dist/record.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch --preserveWatchOutput",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@agentport/shared": "workspace:*",
    "@openuidev/lang-core": "1.1.1",
    "acorn": "8.19.0",
    "effect": "catalog:",
    "file-type": "22.3.0",
    "ipaddr.js": "2.5.0",
    "lru-cache": "11.5.3",
    "pino": "catalog:",
    "yaml": "2.9.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:"
  }
}
