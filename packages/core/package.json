{
  "name": "@agentport/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./workspace": {
      "types": "./dist/workspace.d.ts",
      "default": "./dist/workspace.js"
    },
    "./workspace-input": {
      "types": "./dist/workspace-input.d.ts",
      "default": "./dist/workspace-input.js"
    },
    "./tools": {
      "types": "./dist/tools.d.ts",
      "default": "./dist/tools.js"
    },
    "./plugin-display": {
      "types": "./dist/plugin-display.d.ts",
      "default": "./dist/plugin-display.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch --preserveWatchOutput",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@agentport/shared": "workspace:*",
    "@openuidev/lang-core": "1.0.1",
    "effect": "catalog:",
