{
  "name": "agentport",
  "version": "0.14.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.3",
  "workspaces": {
    "packages": [
      "packages/*"
    ],
    "catalog": {
      "@modelcontextprotocol/client": "2.4.0",
      "@types/bun": "1.4.4",
      "@types/node": "24.19.2",
      "bullmq": "6.7.4",
      "drizzle-orm": "0.45.4",
      "effect": "4.1.4",
      "pino": "10.4.0",
      "typescript": "7.0.2",
      "zod": "4.6.7"
    }
  },
  "trustedDependencies": [
    "esbuild",
    "msgpackr-extract"
  ],
  "engines": {
    "node": ">=24.22.2 <25",
    "bun": "1.4.3"
  },
  "scripts": {
    "dev": "bun run --parallel --filter './packages/*' dev",
    "up": "bash scripts/up.sh",
    "down": "bash scripts/down.sh",
    "build": "bun run --filter './packages/*' build",
    "typecheck": "bun run --filter './packages/*' typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "lint:focus": "node scripts/check-focus-contract.mjs",
    "lint:contract": "node scripts/check-project-contract.mjs",
    "openui:meta": "node scripts/generate-openui-meta.mjs",
    "openui:spec": "node scripts/generate-openui-meta.mjs && openui generate packages/web/src/openui/library.tsx --spec --out packages/core/src/generated/openui.spec.json --no-telemetry",
    "test": "bun scripts/test-backend.ts",
    "test:web": "vitest run --config packages/web/vitest.config.ts",
    "test:watch": "bun scripts/test-backend.ts --watch",
    "test:e2e": "e2e run",
    "e2e:channel": "bun run --filter @agentport/shared --filter @agentport/db --filter @agentport/core build && bun --cwd packages/worker ../../scripts/e2e-channel.ts",
    "e2e:channel:stack": "bun run --filter @agentport/shared --filter @agentport/db --filter @agentport/core build && E2E_CHANNEL_MODE=stack bun --cwd packages/worker ../../scripts/e2e-channel.ts",
    "e2e:channel:ui": "bun run --filter @agentport/shared --filter @agentport/db --filter @agentport/core build && E2E_CHANNEL_MODE=ui bun --cwd packages/worker ../../scripts/e2e-channel.ts",
    "e2e:channel:execution": "bun run --filter @agentport/shared --filter @agentport/db --filter @agentport/core build && E2E_CHANNEL_MODE=execution bun --cwd packages/worker ../../scripts/e2e-channel.ts",
    "e2e:suite": "bun run --filter @agentport/shared --filter @agentport/db --filter @agentport/core build && E2E_CHANNEL_MODE=suite bun scripts/e2e-channel.ts",
    "e2e:channels-business": "e2e run --config e2e.channels-business.config.ts",
    "dev:data": "node -e \"process.env.E2E_DEV_DATA='1';process.env.E2E_DEV_DATA_VERIFY='0';const {spawnSync}=require('node:child_process');const r=spawnSync(process.execPath,['node_modules/e2e/dist/cli/bin.js','run','--config','e2e.dev-data.config.ts','--exclude-tag','verify','--grep-invert','verify'],{stdio:'inherit',env:process.env});process.exit(r.status??1)\"",
    "dev:data:verify": "node -e \"process.env.E2E_DEV_DATA='1';process.env.E2E_DEV_DATA_VERIFY='1';const {spawnSync}=require('node:child_process');const r=spawnSync(process.execPath,['node_modules/e2e/dist/cli/bin.js','run','--config','e2e.dev-data.config.ts','--grep','verify'],{stdio:'inherit',env:process.env});process.exit(r.status??1)\"",
    "db:generate": "bun run --filter @agentport/db generate",
    "db:migrate": "bun run --filter @agentport/db migrate",
    "backup": "bash scripts/backup.sh",
    "restore": "bash scripts/restore.sh",
    "smoke": "bash scripts/smoke.sh",
    "visual:shots": "node scripts/visual-shots.mjs",
    "infra:up": "docker compose up -d postgres redis",
    "infra:down": "docker compose down",
    "clean": "rm -rf packages/*/dist packages/*/node_modules node_modules",
    "openui:check": "node scripts/check-openui.mjs",
    "openui:audit": "node scripts/audit-openui-coverage.mjs"
  },
  "devDependencies": {
    "@ai-sdk/openai-compatible": "^3.0.90",
    "@biomejs/biome": "2.6.6",
    "@e2e-dev/web": "0.15.4",
    "@openuidev/cli": "0.6.3",
    "@openuidev/react-ui": "0.18.1",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "ai": "^7.0.169",
    "e2e": "0.22.0",
    "jsdom": "30.1.3",
    "msw": "3.0.5",
    "portless": "0.15.12",
    "typescript": "catalog:",
    "vitest": "5.1.0"
  }
}
