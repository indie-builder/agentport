{
  "name": "agentport",
  "version": "0.14.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24.22.2 <25"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter './packages/*' dev",
    "up": "bash scripts/up.sh",
    "down": "bash scripts/down.sh",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "lint:focus": "node scripts/check-focus-contract.mjs",
    "lint:contract": "node scripts/check-project-contract.mjs",
    "openui:meta": "node scripts/generate-openui-meta.mjs",
    "openui:spec": "node scripts/generate-openui-meta.mjs && openui generate packages/web/src/openui/library.tsx --spec --out packages/core/src/generated/openui.spec.json --no-telemetry",
    "test": "vitest run",
    "test:web": "vitest run --config packages/web/vitest.config.ts",
    "test:watch": "vitest",
    "test:e2e": "e2e run",
    "e2e:channel": "pnpm --filter @agentport/shared --filter @agentport/db --filter @agentport/core build && pnpm --filter @agentport/worker exec tsx ../../scripts/e2e-channel.ts",
    "e2e:channel:stack": "pnpm --filter @agentport/shared --filter @agentport/db --filter @agentport/core build && E2E_CHANNEL_MODE=stack pnpm --filter @agentport/worker exec tsx ../../scripts/e2e-channel.ts",
    "e2e:channel:ui": "pnpm --filter @agentport/shared --filter @agentport/db --filter @agentport/core build && E2E_CHANNEL_MODE=ui pnpm --filter @agentport/worker exec tsx ../../scripts/e2e-channel.ts",
    "dev:data": "node -e \"process.env.E2E_DEV_DATA='1';process.env.E2E_DEV_DATA_VERIFY='0';const {spawnSync}=require('node:child_process');const r=spawnSync(process.execPath,['node_modules/e2e/dist/cli/bin.js','run','--config','e2e.dev-data.config.ts','--exclude-tag','verify','--grep-invert','verify'],{stdio:'inherit',env:process.env});process.exit(r.status??1)\"",
    "dev:data:verify": "node -e \"process.env.E2E_DEV_DATA='1';process.env.E2E_DEV_DATA_VERIFY='1';const {spawnSync}=require('node:child_process');const r=spawnSync(process.execPath,['node_modules/e2e/dist/cli/bin.js','run','--config','e2e.dev-data.config.ts','--grep','verify'],{stdio:'inherit',env:process.env});process.exit(r.status??1)\"",
    "db:generate": "pnpm --filter @agentport/db generate",
    "db:migrate": "pnpm --filter @agentport/db migrate",
    "backup": "bash scripts/backup.sh",
    "restore": "bash scripts/restore.sh",
    "smoke": "bash scripts/smoke.sh",
    "visual:shots": "node scripts/visual-shots.mjs",
    "infra:up": "docker compose up -d postgres redis",
    "infra:down": "docker compose down",
    "clean": "pnpm -r exec rm -rf dist node_modules && rm -rf node_modules",
    "openui:check": "node scripts/check-openui.mjs",
    "openui:audit": "node scripts/audit-openui-coverage.mjs"
  },
  "devDependencies": {
    "@ai-sdk/openai-compatible": "^3.0.82",
    "@biomejs/biome": "2.6.4",
    "@e2e-dev/web": "0.15.4",
    "@openuidev/cli": "0.6.1",
    "@openuidev/react-ui": "0.18.1",
    "@types/node": "catalog:",
    "ai": "^7.0.159",
    "e2e": "0.22.0",
    "jsdom": "30.1.3",
    "msw": "3.0.3",
    "portless": "0.15.12",
    "typescript": "catalog:",
    "vitest": "5.0.5"
  }
}
