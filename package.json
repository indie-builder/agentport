{
  "name": "agentport",
  "version": "0.14.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.5",
  "workspaces": {
    "packages": [
      "packages/*"
    ],
    "catalog": {
      "@anthropic-ai/claude-agent-sdk": "0.3.332",
      "@modelcontextprotocol/client": "2.4.0",
      "@orpc/contract": "1.16.6",
      "@types/bun": "1.4.5",
      "@types/node": "24.19.4",
      "@ui-sdk/core": "0.1.0-beta.19",
      "@ui-sdk/react": "0.1.0-beta.19",
      "better-auth": "1.7.28",
      "bullmq": "6.7.10",
      "csv-parse": "7.0.3",
      "drizzle-orm": "0.45.4",
      "effect": "4.1.7",
      "lru-cache": "11.5.3",
      "mdast-util-from-markdown": "2.1.0",
      "nodemon": "3.1.14",
      "p-limit": "7.3.3",
      "pino": "10.4.0",
      "typescript": "7.0.2",
      "zod": "4.6.7"
    }
  },
  "trustedDependencies": [
    "esbuild",
    "msgpackr-extract"
  ],
  "overrides": {
    "@hono/node-server": "2.1.11",
    "body-parser": "2.4.0",
    "fast-uri": "3.1.9",
    "hono": "4.13.23",
    "katex": "0.18.2",
    "nodemon>minimatch": "11.0.9",
    "uuid": "11.1.1"
  },
  "engines": {
    "node": ">=24.22.2 <25",
    "bun": "1.4.5"
  },
  "scripts": {
    "dev": "bun run --parallel --filter './packages/*' dev",
    "up": "bash scripts/up.sh",
    "down": "bash scripts/down.sh",
    "build": "bun run --filter './packages/*' build",
    "typecheck": "bun run --filter './packages/*' typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "audit": "bun audit --registry https://registry.npmjs.org",
    "lint:focus": "bun scripts/check-focus-contract.mjs",
    "lint:design": "bun run --filter @agentport/web lint:design",
    "lint:contract": "bun scripts/check-project-contract.mjs",
    "lint:contract:test": "bun test --cwd scripts ./check-project-contract.test.ts",
    "lint:lines": "bun scripts/check-file-lines.mjs",
    "lint:docs": "bun scripts/check-docs.mjs",
    "openui:meta": "bun scripts/generate-openui-meta.mjs",
    "openui:spec": "bun scripts/generate-openui-meta.mjs && openui generate packages/web/src/openui/library.tsx --spec --out packages/core/src/generated/openui.spec.json --no-telemetry",
    "test": "bun scripts/test-backend.ts",
    "test:sharded": "bun scripts/test-backend-sharded.ts",
    "test:web": "vitest run --config packages/web/vitest.config.ts",
    "test:watch": "bun scripts/test-backend.ts --watch",
    "test:e2e": "e2e run",
    "ci": "bun scripts/ci.ts",
    "ci:e2e": "bun scripts/ci.ts --e2e",
    "verify:formal": "bun scripts/verify-formal.ts",
    "e2e:channel": "bun run --filter @agentport/shared --filter @agentport/contract --filter @agentport/db --filter @agentport/core build && bun --cwd packages/worker ../../scripts/e2e-channel.ts",
    "e2e:channel:stack": "bun run --filter @agentport/shared --filter @agentport/contract --filter @agentport/db --filter @agentport/core build && E2E_CHANNEL_MODE=stack bun --cwd packages/worker ../../scripts/e2e-channel.ts",
    "e2e:channel:ui": "bun run --filter @agentport/shared --filter @agentport/contract --filter @agentport/db --filter @agentport/core build && E2E_CHANNEL_MODE=ui bun --cwd packages/worker ../../scripts/e2e-channel.ts",
    "e2e:channel:execution": "bun run --filter @agentport/shared --filter @agentport/contract --filter @agentport/db --filter @agentport/core build && E2E_CHANNEL_MODE=execution bun --cwd packages/worker ../../scripts/e2e-channel.ts",
    "e2e:suite": "bun run --filter @agentport/shared --filter @agentport/contract --filter @agentport/db --filter @agentport/core build && E2E_CHANNEL_MODE=suite bun scripts/e2e-channel.ts",
    "e2e:channels-business": "e2e run --config e2e.channels-business.config.ts",
    "fake:embeddings": "bun scripts/fake-embeddings.mjs",
    "dev:data": "E2E_DEV_DATA=1 E2E_DEV_DATA_VERIFY=0 e2e run --config e2e.dev-data.config.ts --exclude-tag verify --grep-invert verify",
    "dev:data:verify": "E2E_DEV_DATA=1 E2E_DEV_DATA_VERIFY=1 e2e run --config e2e.dev-data.config.ts --grep verify",
    "db:generate": "bun run --filter @agentport/db generate",
    "db:migrate": "bun run --filter @agentport/db migrate",
    "db:seed": "bun run --filter @agentport/shared --filter @agentport/contract --filter @agentport/db --filter @agentport/core build && bun scripts/seed-demo.ts",
    "backup": "bash scripts/backup.sh",
    "restore": "bash scripts/restore.sh",
    "smoke": "bash scripts/smoke.sh",
    "visual:shots": "bun scripts/visual-shots.mjs",
    "infra:up": "docker compose up -d postgres redis",
    "infra:down": "docker compose down",
    "clean": "rm -rf packages/*/dist packages/*/node_modules node_modules",
    "openui:check": "bun scripts/check-openui.mjs",
    "openui:audit": "bun scripts/audit-openui-coverage.mjs"
  },
  "devDependencies": {
    "@agentport/core": "workspace:*",
    "@agentport/db": "workspace:*",
    "@agentport/shared": "workspace:*",
    "@ai-sdk/openai-compatible": "^3.0.96",
    "@babel/parser": "^8.1.3",
    "@babel/traverse": "^8.1.3",
    "@biomejs/biome": "2.6.9",
    "@e2e-dev/web": "0.17.0",
    "@openuidev/cli": "0.6.3",
    "@openuidev/react-ui": "0.20.1",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "drizzle-orm": "catalog:",
    "e2e": "0.25.0",
    "jsdom": "31.0.1",
    "msw": "3.0.8",
    "portless": "0.18.1",
    "typescript": "catalog:",
    "vitest": "5.1.2"
  }
}
