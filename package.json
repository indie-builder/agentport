{
  "name": "agentport",
  "version": "0.14.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter './packages/*' dev",
    "up": "bash scripts/up.sh",
    "down": "bash scripts/down.sh",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "lint:focus": "node scripts/check-focus-contract.mjs",
    "lint:contract": "node scripts/check-project-contract.mjs",
    "openui:meta": "node scripts/generate-openui-meta.mjs",
    "openui:spec": "node scripts/generate-openui-meta.mjs && openui generate packages/web/src/openui/library.tsx --spec --out packages/core/src/generated/openui.spec.json --no-telemetry",
    "test": "vitest run",
    "test:web": "vitest run --config packages/web/vitest.config.ts",
    "test:watch": "vitest",
    "test:e2e": "e2e run",
    "db:generate": "pnpm --filter @agentport/db generate",
    "db:migrate": "pnpm --filter @agentport/db migrate",
    "backup": "bash scripts/backup.sh",
    "restore": "bash scripts/restore.sh",
    "smoke": "bash scripts/smoke.sh",
    "infra:up": "docker compose up -d postgres redis",
    "infra:down": "docker compose down",
    "clean": "pnpm -r exec rm -rf dist node_modules && rm -rf node_modules",
    "openui:check": "node scripts/check-openui.mjs"
  },
  "devDependencies": {
    "@ai-sdk/openai-compatible": "^3.0.78",
    "@biomejs/biome": "2.6.3",
    "@e2e-dev/web": "0.15.3",
    "@openuidev/cli": "0.6.0",
    "@openuidev/react-ui": "0.18.1",
    "ai": "^7.0.153",
    "e2e": "0.21.3",
    "jsdom": "30.1.3",
    "portless": "0.15.11",
    "typescript": "catalog:",
    "vitest": "5.0.5"
  }
}
