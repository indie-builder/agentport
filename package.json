{
  "name": "agentport",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter './packages/*' dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "db:generate": "pnpm --filter @agentport/db generate",
    "db:migrate": "pnpm --filter @agentport/db migrate",
    "infra:up": "docker compose up -d postgres redis",
    "infra:down": "docker compose down",
    "clean": "pnpm -r exec rm -rf dist node_modules && rm -rf node_modules"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5",
    "@vitest/coverage-v8": "5.0.5"
  }
}
